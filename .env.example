# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development environment.
# Local development values are pre-configured for Docker Compose defaults.
# DO NOT commit .env files containing production secrets to version control.
# ==============================================================================

# Application Metadata
APP_NAME=production-starter
NODE_ENV=development
LOG_LEVEL=info

# Service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001
HOST=0.0.0.0

# Public API origin used by the browser bundle. Must be reachable from the client,
# not from inside Docker. Required for any non-localhost deployment.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Set when the API runs behind nginx, a load balancer or Docker ingress. Without it
# every request looks like it came from the proxy, which disables per-IP rate limiting
# and records the wrong address on sessions and audit logs.
# Accepts true/false, a hop count ("1"), or a comma-separated CIDR allowlist.
TRUST_PROXY=false

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app_db
DATABASE_SSL=false

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (MinIO / S3 Compatible)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=app-uploads
S3_USE_SSL=false
S3_FORCE_PATH_STYLE=true

# Optional Integrations
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Authentication & Session Security (Phase 2)
# Placeholder only. `create-odoo-app` generates a unique value per project, and the
# API refuses to boot in production while this default is still in place.
SESSION_SECRET=a_very_secret_32_character_string_for_session_cookies_change_in_prod
SESSION_COOKIE_NAME=app_session
SESSION_TTL_SECONDS=604800

# Root Account Initial Bootstrap (Phase 2)
INITIAL_ROOT_EMAIL=root@example.com
# Placeholder only. Replaced with generated randomness at scaffold time.
INITIAL_ROOT_PASSWORD=RootSecurePass123!

# Docker port binding. Loopback by default so development services with development
# credentials are not reachable from the network. Change deliberately.
BIND_ADDRESS=127.0.0.1

# Observability (Prometheus & Grafana)
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ANONYMOUS=false
MINIO_CONSOLE_PORT=9001
