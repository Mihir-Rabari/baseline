{
  "name": "baseline",
  "version": "0.1.0",
  "description": "Baseline - Full-Stack Monorepo Application",
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.1.0"
  },
  "scripts": {
    "dev": "pnpm --filter \"@app/*\" --parallel dev",
    "dev:api": "pnpm --filter @app/api dev",
    "dev:web": "pnpm --filter @app/web dev",
    "build": "pnpm --filter \"@packages/*\" build && pnpm --filter \"@app/*\" build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --filter \"@packages/*\" build && pnpm --recursive typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run packages/auth packages/iam apps/api",
    "audit:deps": "pnpm audit --prod --audit-level moderate",
    "deps:check": "tsx scripts/check-deps.ts",
    "skills:check": "tsx scripts/check-skills.ts",
    "skills:lint": "tsx scripts/check-skills.ts --lint",
    "skills:pack": "tsx scripts/pack-skills.ts",
    "skills:export": "tsx scripts/pack-skills.ts --export",
    "skills:list": "tsx scripts/pack-skills.ts --list",
    "skills:show": "tsx scripts/pack-skills.ts --show",
    "verify": "pnpm skills:check && pnpm skills:lint && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "setup": "tsx scripts/setup.ts",
    "db:generate": "pnpm --filter @packages/db db:generate",
    "db:migrate": "pnpm --filter @packages/db db:migrate",
    "db:seed": "pnpm --filter @packages/db db:seed",
    "db:seed:activity": "pnpm --filter @app/api seed:activity",
    "db:studio": "pnpm --filter @packages/db db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "health": "tsx scripts/health-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  },
  "private": true
}
